# Copy this file to .env and fill in what you have.
# The app runs fully with NONE of these set — every feature has a free/offline fallback.

# Hugging Face free Inference API token (https://huggingface.co/settings/tokens)
HF_API_TOKEN=
HF_SYMPTOM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
HF_EDUCATION_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# LibreTranslate — use the public instance or self-host (docker run libretranslate/libretranslate)
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=

# Required by OpenStreetMap Nominatim's usage policy — put a real contact
NOMINATIM_USER_AGENT=ai-health-kiosk/1.0 (contact: you@example.com)

# Firebase: either a path to a service-account JSON file, or the raw JSON as a string
FIREBASE_CREDENTIALS_JSON=
FIREBASE_DB_URL=

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-project.web.app

# Simple shared code the Doctor Dashboard sends to view records (NOT production auth)
DOCTOR_ACCESS_CODE=demo-doctor-2026
